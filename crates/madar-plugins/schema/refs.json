{
  "version": 1,
  "collections": {
    "refs.refs": {
      "type": "object",
      "properties": {
        "from": {
          "type": "object",
          "description": "{type, id}"
        },
        "to": {
          "type": "object",
          "description": "{type, id, ..}"
        },
        "from_key": {
          "type": "string",
          "index": true
        },
        "to_key": {
          "type": "string",
          "index": true
        },
        "title": {
          "type": "string"
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "from_key",
        "to_key"
      ]
    }
  }
}
