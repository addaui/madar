        "name": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "unique": true
        },
        "space": {
          "type": "string",
          "index": true
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "color": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "name"
            ]
          }
        },
        "attributes": {
          "type": "array",
